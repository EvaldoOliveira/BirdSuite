# Station-private layer, docs and reference clones (owner 2026-10-07): custom/ lives in
# ~/Documents/Birdnet/custom (symlinked here), backed up nightly to the NAS, never in git.
# Installs without it run the plain fork (no station layer).
/custom
/firstrun_pending
# station species lists (Settings > Species list filter)
species_lists/
# raw recordings (Raw Recording page)
raw-recording/
scripts/region_profile.json
# species table additions looked up on the station (scripts/update_species_info.sh)
model/species_info_local.csv
model/species_info_local.csv.tmp
species_info_build.log
# station data (US-117): the registered stations, written by the Stations page
# station data (US-58): the locations, and the microphone-reconnected question of the Now page
mic_reconnected.json
.mic_removed
location_job.json
location_job.lock
notify_queue.jsonl*

# station data: the Telegram group names shown by Settings › Telegram
telegram_groups.json

# station data: the custom themes of Settings › Appearance
custom_themes.json

# station data: the rare-tier Apprise config, its body and the Apprise secrets (placeholders' values, 600)
apprise-rare.txt
apprise-tokens.txt
body-rare.txt
# station data: the boot location check
location_check.json

# station data: the saved variations of System › Defaults
settings_profiles/
location_switch.json
location_switch.json.tmp
species_max_files.txt

# the station's own files (owner 2026-10-22): settings, lists, notifications, locations, the database
/config/*
# the factory defaults ship with the program (owner 2026-10-22)
!/config/factory_defaults.conf
# the running state of the station (owner 2026-10-22)
/state/
