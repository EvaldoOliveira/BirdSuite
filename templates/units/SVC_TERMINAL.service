[Unit]
Description=BirdSuite Web Terminal
[Service]
# the login is an ssh session to the station itself (scripts/web_console.sh, bug #61): the shell has nothing taken away, this service is sandboxed (install_helpers.sh hardening_dropin console); the page and the web server ask for the web login first
Restart=on-failure
RestartSec=3
Type=simple
User=@USER@
Environment=TERM=xterm-256color
RuntimeDirectory=birdsuite-terminal
RuntimeDirectoryMode=0700
ExecStart=@BS_BIN@/gotty --address localhost -w -p @BS_PORT_TERMINAL@ --path terminal --title-format "BirdSuite Terminal" @BS_SCRIPTS@/web_console.sh
[Install]
WantedBy=multi-user.target
