[Unit]
Description=BirdSuite Web Terminal
[Service]
# hardening exception (release run 6, HRD-01): the console login runs su, which needs setuid and the whole system: no sandbox on purpose (the page and the web server ask for the login)
Restart=on-failure
RestartSec=3
Type=simple
User=@USER@
Environment=TERM=xterm-256color
ExecStart=@BS_BIN@/gotty --address localhost -w -p @BS_PORT_TERMINAL@ --path terminal --title-format "BirdSuite Terminal" bash -c 'read -p "Login: " username && [[ "$username" =~ ^[-_.a-z0-9]{1,30}$ ]] && su --pty -l $username'
[Install]
WantedBy=multi-user.target
