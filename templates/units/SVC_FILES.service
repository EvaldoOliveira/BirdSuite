[Unit]
Description=BirdSuite Browse files (Midnight Commander)
[Service]
# the login is an ssh session to the station itself running mc (scripts/web_console.sh, bug #61): this service is sandboxed (install_helpers.sh hardening_dropin console); behind the web login
Restart=on-failure
RestartSec=3
Type=simple
User=@USER@
Environment=TERM=xterm-256color
RuntimeDirectory=birdsuite-files
RuntimeDirectoryMode=0700
ExecStart=@BS_BIN@/gotty --address localhost -w -p @BS_PORT_FILES@ --path files --title-format "BirdSuite Files" @BS_SCRIPTS@/web_console.sh mc
[Install]
WantedBy=multi-user.target
