[Unit]
Description=BirdSuite Browse files (Midnight Commander)
[Service]
# hardening exception (release run 6, HRD-01): the file browser runs su to the logged-in user, which needs setuid: no sandbox on purpose (behind the web login)
Restart=on-failure
RestartSec=3
Type=simple
User=@USER@
Environment=TERM=xterm-256color
ExecStart=@BS_BIN@/gotty --address localhost -w -p @BS_PORT_FILES@ --path files --title-format "BirdSuite Files" bash -c 'read -p "Login: " username && [[ "$username" =~ ^[-_.a-z0-9]{1,30}$ ]] && su --pty -l $username -c mc'
[Install]
WantedBy=multi-user.target
