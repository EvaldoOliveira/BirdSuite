#birdnet
*/5 * * * * $USER /usr/local/bin/disk_check.sh >/dev/null 2>&1
#birdnet
0 2 * * * $USER /usr/local/bin/disk_species_clean.sh >/dev/null 2>&1
#birdnet
*/3 * * * * $USER /usr/local/bin/cleanup.sh >/dev/null 2>&1
#birdnet
@reboot $USER /usr/local/bin/cleanup.sh >/dev/null 2>&1
#birdnet
* * * * * $USER /home/$USER/BirdNET-Pi/birdnet/bin/python3 /home/$USER/BirdNET-Pi/scripts/recording_watchdog.py >/dev/null 2>&1
#birdnet
*/15 * * * * $USER /home/$USER/BirdNET-Pi/birdnet/bin/python3 /home/$USER/BirdNET-Pi/scripts/ebird_report.py due >/dev/null 2>&1
