# BirdSuite core definitions (owner 2026-11-02): the one place for the program's folder names and layout, its service
# names, ports, root helper paths and the fixed values several files share. Plain KEY=value lines, read as text by
# one small reader per language (scripts/core.sh, scripts/core.php, scripts/utils/core.py), never executed.
# Rules: a whole line starting with # is a comment; no quotes, no spaces around =; ${KEY} names a key above or a seed.
# Seeds, set by the reader before this file: BS_HOME (the station user's home) and, when the reader runs from the
# program folder, BS_PROG (that folder). A key already set (a seed) keeps its value.
# The station user is not here: it is found at run time (the owner of the program folder, root records it at install).
# Templates (templates/units, cron, sudoers, Caddyfile) name these keys as @BS_KEY@; the installer and the update fill them.

# ---- folders: names in the station user's home ----
BS_PROG_DIR=BirdSuite
BS_DATA_DIR=BirdSongs
BS_VENV_DIR=venv
BS_PROG=${BS_HOME}/${BS_PROG_DIR}
# the program folder of the original project (BirdNET-Pi), looked for when its home is imported
BS_UPSTREAM_PROG_DIR=BirdNET-Pi

# ---- the program folder ----
BS_SCRIPTS=${BS_PROG}/scripts
BS_TEMPLATES=${BS_PROG}/templates
BS_MODEL=${BS_PROG}/model
BS_HOMEPAGE=${BS_PROG}/homepage
BS_VENV=${BS_PROG}/${BS_VENV_DIR}
BS_PYTHON=${BS_VENV}/bin/python3
BS_PIP=${BS_VENV}/bin/pip3
# the station's own files (settings, lists, notifications, locations, the database), backed up
BS_CONFIG=${BS_PROG}/config
BS_CONF=${BS_CONFIG}/BirdSuite.conf
BS_DEFAULTS=${BS_CONFIG}/factory_defaults.conf
BS_LISTS=${BS_CONFIG}/species_lists
BS_CUSTOM_LISTS=${BS_LISTS}/custom
BS_NOTIFY=${BS_CONFIG}/notifications
BS_LOCATIONS=${BS_CONFIG}/locations
BS_LOCATIONS_FILE=${BS_LOCATIONS}/locations.json
BS_DATA=${BS_CONFIG}/data
BS_DB=${BS_DATA}/birds.db
BS_CONFIG_SCRIPTS=${BS_CONFIG}/scripts
BS_DISK_EXCLUDE=${BS_CONFIG_SCRIPTS}/disk_check_exclude.txt
BS_CUSTOM=${BS_CONFIG}/custom
# the running state (not settings: outside config/ and the backup)
BS_STATE=${BS_PROG}/state
BS_CACHE=${BS_STATE}/cache
BS_FIRSTRUN=${BS_STATE}/firstrun_pending
BS_MIC_REMOVED=${BS_STATE}/.mic_removed
BS_MIC_RECONNECTED=${BS_STATE}/mic_reconnected.json
# the microphones seen at the last hot-plug and the last change of them, named, for the window of every page (2026-11-03)
BS_MIC_SEEN=${BS_STATE}/mics_seen.json
BS_MIC_EVENT=${BS_STATE}/mic_event.json
# the microphone the station records with when none is chosen in Settings › Audio: the first one it used, kept while it is
# away, so it is taken again when it returns (2026-11-03)
BS_MIC_PREFERRED=${BS_STATE}/mic_preferred
BS_HTTPS_TEMP=${BS_STATE}/https_temp
# the owner's own choice of the RAM drive in System › Status (on / off); without it the memory decides (2026-11-03)
BS_RAMDISK_CHOICE=${BS_STATE}/ramdisk_choice
BS_ANNOUNCED=${BS_STATE}/announced_address
BS_NOTIFY_QUEUE=${BS_STATE}/notify_queue.jsonl
BS_PURGE_LOCK=${BS_STATE}/purge.lock
BS_LOCATION_CHECK=${BS_STATE}/location_check.json
BS_BACKUP_RUNNING=${BS_STATE}/backup_running
BS_BACKUP_DEFERRED=${BS_STATE}/backup_deferred
BS_SETTINGS_HISTORY_LOG=${BS_STATE}/settings_history.log
BS_DISK_FORECAST=${BS_STATE}/disk-forecast.json
BS_DISK_USAGE_LOG=${BS_STATE}/disk-usage.log
BS_DISK_PARTS_LOG=${BS_STATE}/disk-parts.log
# the station user's own ALSA file: the shared microphone device of US-07 (scripts/install_audio.sh writes it)
BS_ASOUNDRC=${BS_HOME}/.asoundrc
# the raw recordings (Tools › Raw Recording): long WAV sessions, in the home folder, outside the program folder and its backup
BS_RAW_REC=${BS_HOME}/raw-recording
# the raw recording groups, one per microphone (Tools › Raw Recording, scripts/raw_groups.py)
BS_RAW_REC_FILE=${BS_CONFIG}/raw_recording.json
# the factory web password (owner 2026-11-02: a password on everything): used while CADDY_PWD is empty; user birdsuite
BS_WEB_PASSWORD_DEFAULT=birdsuite
# the migration from the original project on the same card (US-01, US-05): its record (mode, start, what is kept), the
# database moved aside until it is imported (move mode), and the original settings kept as a .tar.gz (move mode)
BS_MIGRATION=${BS_STATE}/migration.json
BS_MIGRATION_DIR=${BS_STATE}/migration
BS_UPSTREAM_ARCHIVE=${BS_CONFIG}/BIRDNET.OLD.gz
# the suffix of the original program and data folders kept during the test period, the days of that period, and the
# space the installer counts for BirdSuite itself (program, venv, packages) and as a margin, in MB
BS_OLD_SUFFIX=.old
BS_MIGRATION_DAYS=30
BS_INSTALL_ESTIMATE_MB=2500
BS_MIGRATION_MARGIN_MB=500

# ---- the data folder (recordings, clips) ----
BS_RECS=${BS_HOME}/${BS_DATA_DIR}
BS_EXTRACTED=${BS_RECS}/Extracted
BS_BY_DATE=${BS_EXTRACTED}/By_Date
BS_REMOVED=${BS_EXTRACTED}/Removed
# the spool of the BirdDB-Br sound repository (US-18) when SOUND_REPO_PATH is empty
BS_SOUND_REPO=${BS_RECS}/SoundRepo
BS_PROCESSED=${BS_RECS}/Processed
BS_STREAMDATA=${BS_RECS}/StreamData
BS_ANALYZING_NOW=${BS_STREAMDATA}/analyzing_now.txt

# ---- services (systemd unit names without .service; templates/units/<KEY without BS_>.<type> is each unit) ----
BS_SVC_ANALYSIS=birdsuite_analysis
BS_SVC_RECORDING=birdsuite_recording
BS_SVC_LOG=birdsuite_log
BS_SVC_LOCATION_CHECK=birdsuite_location_check
BS_SVC_LIVESTREAM=birdsuite_livestream
BS_SVC_SPECTROGRAM=birdsuite_spectrogram
BS_SVC_TERMINAL=birdsuite_terminal
BS_SVC_FILES=birdsuite_files
BS_SVC_SETTINGS_HISTORY=birdsuite_settings_history
BS_SVC_FIELD=birdsuite_field
BS_SVC_BLE=birdsuite_ble
# the forgotten web password: reset-web-password on the boot partition read at start-up (US-53)
BS_SVC_PWRESET=birdsuite_pwreset
BS_SVC_MIC_HOTPLUG=birdsuite_mic_hotplug
BS_SVC_SOUND_UPLOAD=birdsuite_sound_upload
# system packages BirdSuite drives (their own names)
BS_SVC_ICECAST=icecast2
BS_SVC_WEB=caddy

# ---- root side (root-owned, outside the program folder) ----
BS_LIB=/usr/local/lib/birdsuite
BS_SVC_HELPER=/usr/local/sbin/birdsuite-svc
BS_ROOT_HELPER=/usr/local/sbin/birdsuite-root
BS_BIN=/usr/local/bin
BS_UNIT_DIR=/usr/lib/systemd/system
BS_SUDOERS=/etc/sudoers.d/020_birdsuite
BS_UDEV_DIR=/etc/udev/rules.d
BS_CADDYFILE=/etc/caddy/Caddyfile
# root's own record of a migration (the original units, the system files the installation changes), for Go back
BS_MIGRATION_ROOT=${BS_LIB}/migration

# ---- ports (localhost; Caddy is the only door) ----
BS_PORT_LOG=8080
BS_PORT_TERMINAL=8888
BS_PORT_FILES=8889
BS_PORT_ICECAST=8000

